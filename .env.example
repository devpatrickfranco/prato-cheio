# Copie para .env (que não é versionado) e ajuste os valores.
# O docker-compose.yml carrega o .env automaticamente (env_file) e exige que ele exista.
# Sem DJANGO_DEBUG=True o projeto sobe em modo produção (config/settings.py): exige chave secreta e hosts
# próprios, redireciona para HTTPS e usa o manifest de estáticos (rode collectstatic antes).

# Chave secreta: obrigatória em produção (o app não inicia com DJANGO_DEBUG=False sem ela). Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-esta-chave

# O padrão é False (produção). Para rodar localmente, deixe True; em produção, False.
DJANGO_DEBUG=True

# Caminho do painel de administração (padrão: admin/). EM PRODUÇÃO, TROQUE por um valor difícil de adivinhar.
# DJANGO_ADMIN_URL=gestao-troque-este-caminho/

# Hosts aceitos, separados por vírgula (obrigatório quando DJANGO_DEBUG=False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Produção com HTTPS: origens confiáveis para formulários (CSRF), separadas por vírgula.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://prato.exemplo.com

# Produção (DJANGO_DEBUG=False):
# - DJANGO_SSL_REDIRECT (padrão True) redireciona http -> https. Para testar o modo produção em
#   http://localhost sem TLS, use DJANGO_SSL_REDIRECT=False. Fora do localhost o modo produção exige HTTPS:
#   os cookies de sessão, CSRF e JWT são marcados como Secure.
# - Atrás de proxy/balanceador que termina TLS, DJANGO_PROXY_SSL=True é OBRIGATÓRIO (confia em
#   X-Forwarded-Proto). Sem ele, o Django nunca vê a requisição como segura e entra em laço de redirecionamento.
# - DJANGO_HSTS_SECONDS (padrão 3600). HSTS é difícil de desfazer: suba o valor (ex.: 31536000) só depois
#   de validar o HTTPS em produção.
# DJANGO_PROXY_SSL=True
# DJANGO_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=3600
# Cabeçalho com o IP real do cliente (usado no limite de tentativas de login). Ex.: HTTP_X_FORWARDED_FOR
# Cada proxy confiável acrescenta um valor ao fim do cabeçalho. Informe quantos proxies ficam na frente do app
# (padrão 1; use 2 para CDN + nginx, por exemplo). Com o número errado, todos os clientes parecem ter o mesmo IP
# e 20 senhas erradas bloqueiam o login de todo mundo.
# DJANGO_PROXY_IP_HEADER=HTTP_X_FORWARDED_FOR
# DJANGO_PROXIES_CONFIAVEIS=1

# PostgreSQL (serviço `db` do docker-compose). O docker-compose define POSTGRES_HOST=db para o web;
# sem POSTGRES_HOST (execução local sem Docker), o projeto usa SQLite.
POSTGRES_DB=prato_cheio
POSTGRES_USER=prato_cheio
POSTGRES_PASSWORD=troque-esta-senha

# JWT (apps.auth). Sem DJANGO_JWT_SECRET_KEY, os tokens são assinados com DJANGO_SECRET_KEY.
DJANGO_JWT_SECRET_KEY=troque-esta-chave-jwt
DJANGO_JWT_ACCESS_MINUTES=15
DJANGO_JWT_REFRESH_DAYS=7

# Geocodificação de endereço/CEP (Nominatim/OpenStreetMap) no cadastro. Ligada por padrão, e desligada
# automaticamente em `manage.py test` quando a variável NÃO está definida. Se definida, vale também nos
# testes (por isso fica comentada). Use False para desligar.
# DJANGO_GEOCODIFICACAO=False

# E-mail (recuperação de senha). Sem DJANGO_EMAIL_HOST, os e-mails aparecem apenas no console do servidor.
# DJANGO_EMAIL_HOST=smtp.exemplo.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=usuario
# DJANGO_EMAIL_PASSWORD=senha
# DJANGO_EMAIL_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=Prato Cheio <nao-responda@seudominio.com>
