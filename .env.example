# Copie para .env e ajuste. Nunca commite o .env.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT (se vazio, usa a DJANGO_SECRET_KEY)
JWT_SECRET_KEY=
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7

# Comissao cobrada sobre vendas, em porcentagem
COMISSAO_PERCENTUAL=8

# PostgreSQL (se POSTGRES_DB estiver vazio, usa SQLite local)
POSTGRES_DB=prato_cheio
POSTGRES_USER=prato_cheio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
