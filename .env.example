# Copie para .env (que não é versionado) e ajuste os valores.
# Sem essas variáveis, o projeto usa os padrões de desenvolvimento de config/settings.py.

# Chave secreta: obrigatória em produção. Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-esta-chave

# True em desenvolvimento, False em produção.
DJANGO_DEBUG=True

# Hosts aceitos, separados por vírgula (obrigatório quando DJANGO_DEBUG=False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT (apps.auth). Sem DJANGO_JWT_SECRET_KEY, os tokens são assinados com DJANGO_SECRET_KEY.
DJANGO_JWT_SECRET_KEY=troque-esta-chave-jwt
DJANGO_JWT_ACCESS_MINUTES=15
DJANGO_JWT_REFRESH_DAYS=7
